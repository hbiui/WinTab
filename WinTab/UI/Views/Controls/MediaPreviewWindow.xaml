<Window x:Class="WinTab.UI.Views.Controls.MediaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaPreview"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="348"
        SizeToContent="Height"
        Focusable="False">
    <Border x:Name="Root"
            Background="#F7F2F2F2"
            BorderBrush="#33000000"
            BorderThickness="1"
            CornerRadius="10"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Content: thumbnail / video player / text preview -->
            <Grid Grid.Row="0" Margin="10,10,10,4" MinHeight="120">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                       Visibility="Collapsed" />
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual" UnloadedBehavior="Close"
                              Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                              ScrubbingEnabled="True"
                              MediaOpened="Player_MediaOpened"
                              MediaFailed="Player_MediaFailed"
                              Visibility="Collapsed" />
                <ScrollViewer x:Name="TextScroll"
                              MaxHeight="260" MaxWidth="320"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <TextBlock x:Name="PreviewText"
                               FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" Text="" />
                </ScrollViewer>
                <TextBlock x:Name="FallbackText"
                           Text="◌"
                           FontSize="56" Foreground="#66000000"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>

            <!-- Playback controls: video and audio only -->
            <DockPanel Grid.Row="1" x:Name="ControlsBar" Margin="10,0,10,2" LastChildFill="False" Visibility="Collapsed">
                <Button x:Name="PlayPauseButton" Content="⏸" Width="30" Height="24" Click="PlayPauseButton_Click"
                        Background="#14000000" BorderThickness="0" FontSize="12" Cursor="Hand" DockPanel.Dock="Left" />
                <Button x:Name="MuteButton" Content="🔊" Width="30" Height="24" Margin="6,0,0,0" Click="MuteButton_Click"
                        Background="#14000000" BorderThickness="0" FontSize="12" Cursor="Hand" DockPanel.Dock="Left" />
                <TextBlock x:Name="DurationText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Foreground="#88000000" Text="" />
            </DockPanel>

            <!-- Info line: kind, dimensions or size -->
            <TextBlock Grid.Row="2" x:Name="InfoText"
                       Margin="12,0,12,10" FontSize="12" Foreground="#AA000000"
                       TextTrimming="CharacterEllipsis" Text="" />
        </Grid>
    </Border>
</Window>
